# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Environments
.venv/
venv/
env/
.env
.env.*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Patient data must never be committed. CareScribe writes only de-identified
# text to disk, into carescribe/output/deidentified/ — but a de-identified
# clinical document is still not something to push to a git remote, and a
# reviewer may have marked identifiers "Keep" on purpose.
# ---------------------------------------------------------------------------
carescribe/output/
*.deid.txt
*_deidentified.txt
*_deidentified.md
*_carenote.txt
*_carenote.md
*_carenote_PHI.txt
*_carenote_PHI.md
patient_data/
phi/

# ---------------------------------------------------------------------------
# graphify knowledge graph.
#
# graph.json / GRAPH_REPORT.md / graph.html ARE committed — they are the map a
# new session (or a new contributor) starts from. Only the machine-specific and
# local-only bits are ignored: .graphify_python and .graphify_root hold absolute
# paths to this machine's conda env, and cost.json is a local token tally.
# ---------------------------------------------------------------------------
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/
graphify-out/20*/

# ---------------------------------------------------------------------------
# Desktop packaging. The build artefacts and the generation model are large and
# reproducible from source — the build scripts fetch the model on demand.
# ---------------------------------------------------------------------------
build/
dist/
models/
*.gguf

# Generated icons and installer output — reproducible from make_icon.py and the
# build scripts, so they do not belong in git.
packaging/carescribe.png
packaging/carescribe.ico
packaging/carescribe.icns
packaging/Output/
CareScribeSetup.exe
*.dmg

# Local launch shortcut and its icon (point at this machine's dist\ folder).
CareScribe.lnk
CareScribe.ico

# Subagent-driven-development scratch workspace (ledgers, briefs, review
# packages) — the git history is the durable record, not this directory.
.superpowers/
